# Copy to .env and adjust. docker compose reads this file automatically.

# Postgres superuser (container init only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Warehouse connection used by the pipeline and (derived into NFL_DB_* parts) by dbt.
# Inside docker compose the host is `postgres`; from your laptop use localhost.
# Azure Flexible Server needs `?sslmode=require` on the end.
NFL_DATABASE_URL=postgresql://nfl:nfl@localhost:5432/nfl

# First season `backfill` loads by default. Extend later by lowering this or passing --start.
NFL_START_SEASON=2010

# Optional: webhook that receives a short message when a refresh/backfill fails
# (Slack incoming webhook, Discord webhook, https://ntfy.sh/<topic> …). Blank = no alerts.
NFL_ALERT_WEBHOOK_URL=

# Reserved for a future odds snapshot source (The Odds API). Leave blank for now.
ODDS_API_KEY=
