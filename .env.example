# Copy to .env and adjust. docker compose reads this file automatically.

# Airflow runs as this UID inside containers so bind-mounted logs/ are writable. macOS: 50000 is fine.
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Any long random string; shared by api-server and workers for task auth.
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# Postgres superuser (container init only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Warehouse connection used by the pipeline.
# Inside docker compose the host is `postgres`; from your laptop use localhost.
NFL_DATABASE_URL=postgresql://nfl:nfl@localhost:5432/nfl
# dbt (dbt/profiles.yml) needs the same connection as parts. Defaults match the URL above;
# docker compose overrides NFL_DB_HOST=postgres.
#NFL_DB_HOST=localhost
#NFL_DB_PORT=5432
#NFL_DB_USER=nfl
#NFL_DB_PASSWORD=nfl
#NFL_DB_NAME=nfl

# First season the backfill DAG / CLI load by default. Extend later by lowering this or passing --start.
NFL_START_SEASON=2010

# Reserved for the future odds snapshot DAG (The Odds API). Leave blank for now.
ODDS_API_KEY=
